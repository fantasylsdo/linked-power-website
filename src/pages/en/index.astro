---
import '../../styles/global.css';
import SiteHeader from '../../components/SiteHeader.astro';
import HomeMain from '../../components/HomeMain.astro';
import { homeContent } from '../../i18n/content';

const locale = 'en';
const t = homeContent[locale];
---

<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.loli.net" />
    <link rel="preconnect" href="https://gstatic.loli.net" crossorigin />
    <link
      href="https://fonts.loli.net/css2?family=Barlow:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>Linked Power</title>
    <meta name="description" content={t.metaDescription} />
  </head>
  <body class="bg-white text-slate-900 antialiased">
    <SiteHeader locale={locale} />
    <HomeMain locale={locale} />
  </body>
</html>
