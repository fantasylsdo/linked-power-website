---
import { homeContent, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = homeContent[locale];
---

<main class="mx-auto max-w-6xl px-5 pb-16">
  <section id="about" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
        <div>
          <h2 class="mb-2 max-w-[20ch] text-2xl font-bold leading-tight tracking-tight text-slate-900 sm:text-3xl">
            {t.about.title}
          </h2>
          <p class="max-w-[64ch] p-5 text-[1.04rem] leading-relaxed text-slate-600">
            {t.about.desc}
          </p>

          <div class="flex flex-wrap gap-3 p-5">
            <a
              class="inline-flex items-center justify-center bg-brand-red px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-red-dark"
              href="#contact"
            >
              {t.about.ctaConsult}
            </a>
            <a
              class="inline-flex items-center justify-center border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-900 transition-colors hover:border-brand-red hover:text-brand-red"
              href="#products"
            >
              {t.about.ctaProduct}
            </a>
          </div>
        </div>

        <div class="rounded-xl p-4">
          <video
            controls
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            class="w-full rounded-lg bg-black"
          >
            <source src="/hero.mp4" type="video/mp4" />
            {t.about.videoFallback}
          </video>
        </div>
      </div>

      <div class="grid gap-3 md:grid-cols-3 p-5">
        <div class="border border-slate-200 bg-white px-4 py-3">
          <span class="block text-xs text-slate-500">{t.about.kpiCoverageLabel}</span>
          <strong class="text-lg font-bold text-slate-900">{t.about.kpiCoverageValue}</strong>
        </div>
        <div class="border border-slate-200 bg-white px-4 py-3">
          <span class="block text-xs text-slate-500">{t.about.kpiTroubleshootLabel}</span>
          <strong class="text-lg font-bold text-slate-900">{t.about.kpiTroubleshootValue}</strong>
        </div>
        <div class="border border-slate-200 bg-white px-4 py-3">
          <span class="block text-xs text-slate-500">{t.about.kpiInsightLabel}</span>
          <strong class="text-lg font-bold text-slate-900">{t.about.kpiInsightValue}</strong>
        </div>
      </div>
    </div>
  </section>

  <section id="products" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-red">{t.products.tag}</p>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{t.products.title}</h2>
    </div>

    <article class="grid gap-6 bg-white p-5 lg:grid-cols-[1.15fr_0.85fr]">
      <div>
        <h3 class="mb-2 text-xl font-semibold text-slate-900">{t.products.name}</h3>
        <p class="text-slate-600">{t.products.desc}</p>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-slate-600">
          <li>{t.products.feature1}</li>
          <li>{t.products.feature2}</li>
          <li>{t.products.feature3}</li>
        </ul>
      </div>

      <figure class="h-70 overflow-hidden p-3">
        <img
          src="/pl8000.jpg"
          alt={t.products.imageAlt}
          class="h-full w-full object-contain"
          loading="lazy"
        />
      </figure>
    </article>
  </section>

  <section id="cases" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-red">{t.cases.tag}</p>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{t.cases.title}</h2>
    </div>

    <article class="bg-white p-5">
      <p class="text-slate-600">{t.cases.desc}</p>
      <div class="mt-4 grid gap-3 md:grid-cols-3">
        <div class="border border-slate-200 bg-white px-4 py-3">
          <span class="block text-xs text-slate-500">{t.cases.kpi1Label}</span>
          <strong class="text-lg font-bold text-slate-900">-45%</strong>
        </div>
        <div class="border border-slate-200 bg-white px-4 py-3">
          <span class="block text-xs text-slate-500">{t.cases.kpi2Label}</span>
          <strong class="text-lg font-bold text-slate-900">+30%</strong>
        </div>
        <div class="border border-slate-200 bg-white px-4 py-3">
          <span class="block text-xs text-slate-500">{t.cases.kpi3Label}</span>
          <strong class="text-lg font-bold text-slate-900">{t.cases.kpi3Value}</strong>
        </div>
      </div>
    </article>
  </section>

  <section id="downloads" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-red">{t.downloads.tag}</p>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">{t.downloads.title}</h2>
    </div>

    <div class="grid gap-3 p-5">
      <a
        href="#"
        class="flex flex-col justify-between gap-2 border border-slate-200 bg-white p-4 transition-colors hover:border-brand-red md:flex-row"
      >
        <strong class="text-slate-900">{t.downloads.item1}</strong>
        <span class="text-sm text-slate-500">{t.downloads.meta1}</span>
      </a>
      <a
        href="#"
        class="flex flex-col justify-between gap-2 border border-slate-200 bg-white p-4 transition-colors hover:border-brand-red md:flex-row"
      >
        <strong class="text-slate-900">{t.downloads.item2}</strong>
        <span class="text-sm text-slate-500">{t.downloads.meta2}</span>
      </a>
      <a
        href="#"
        class="flex flex-col justify-between gap-2 border border-slate-200 bg-white p-4 transition-colors hover:border-brand-red md:flex-row"
      >
        <strong class="text-slate-900">{t.downloads.item3}</strong>
        <span class="text-sm text-slate-500">{t.downloads.meta3}</span>
      </a>
    </div>
  </section>

  <section id="contact" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-red">{t.contact.tag}</p>
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        {t.contact.titleLine1}<br />{t.contact.titleLine2}
      </h2>
    </div>

    <div class="grid gap-6 rounded-lg bg-white p-5 lg:grid-cols-2">
      <div class="space-y-2 text-slate-700">
        <p><strong>{t.contact.salesLabel}</strong>+86 0513-88888888</p>
        <p><strong>{t.contact.supportLabel}</strong>+86 0513-88888999</p>
        <p><strong>{t.contact.emailLabel}</strong>contact@linked-power.com</p>
        <p><strong>{t.contact.addressLabel}</strong>{t.contact.addressValue}</p>
      </div>
    </div>
  </section>

  <section class="scroll-mt-24 pt-8 text-center text-sm text-slate-500">
    <p>{t.footer.copyright}</p>
  </section>
</main>
