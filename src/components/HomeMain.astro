---
import { homeContent, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = homeContent[locale];
const productImages = {
  pl8000: '/PL8000智能电力监测终端.jpeg',
  energyStorage: '/智能微电网储能EMS.png',
  batterySwap: '/智能移动设备换电系统.jpeg',
};
const productLinks = {
  pl8000: locale === 'en' ? '/en/products/pl8000' : '/products/pl8000',
  energyStorage: locale === 'en' ? '/en/products/energy-storage-ems' : '/products/energy-storage-ems',
  batterySwap: locale === 'en' ? '/en/products/battery-swapping-system' : '/products/battery-swapping-system',
};
const formMessages = {
  submitting: t.contact.formSubmitting,
  success: t.contact.formSuccess,
  error: t.contact.formError,
};
---

<section id="about" class="relative isolate min-h-[min(72vh,680px)] overflow-hidden bg-slate-950 text-white">
  <video
    id="heroVideo"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    class="absolute inset-0 h-full w-full object-cover"
  >
    <source src="/hero.mp4" type="video/mp4" />
    {t.about.videoFallback}
  </video>
  <div class="absolute inset-0 bg-slate-950/55"></div>

  <div class="relative mx-auto flex min-h-[min(72vh,680px)] w-full max-w-6xl items-end px-5 py-14 sm:py-20">
    <div class="max-w-3xl">
      <h1 class="max-w-[22ch] text-3xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
        {t.about.title}
      </h1>
      <p class="mt-6 max-w-[62ch] text-base leading-8 text-white/85 sm:text-lg">
        {t.about.desc}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <button
          type="button"
          data-open-consult-form
          class="inline-flex items-center justify-center bg-brand-red px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-red-dark"
        >
          {t.about.ctaConsult}
        </button>
        <a
          class="inline-flex items-center justify-center border border-white/70 px-5 py-3 text-sm font-bold text-white transition-colors hover:border-white hover:bg-white/10"
          href="#products"
        >
          {t.about.ctaProduct}
        </a>
      </div>
    </div>

  </div>
</section>

<main class="mx-auto max-w-6xl px-5 pb-16">

  <section id="products" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <h2 class="text-2xl font-bold tracking-tight text-[#101b70] sm:text-3xl">{t.products.title}</h2>
    </div>

    <div class="mt-4 grid gap-3 md:grid-cols-3">
      <article class="flex min-h-[25rem] flex-col border border-slate-200 bg-white px-4 py-3">
        <a href={productLinks.pl8000} class="group flex h-full flex-col" aria-label={t.products.items[0].name}>
          <figure class="mb-8 flex h-52 items-center justify-center overflow-hidden p-3">
            <img
              src={productImages.pl8000}
              alt={t.products.items[0].imageAlt}
              class="h-full w-full object-contain transition-transform group-hover:scale-105"
              loading="lazy"
            />
          </figure>
          <div class="px-2 text-center">
            <h3 class="mb-5 text-xl font-semibold leading-snug text-slate-900">{t.products.items[0].name}</h3>
            <p class="text-base leading-relaxed text-slate-900">{t.products.items[0].desc}</p>
          </div>
        </a>
      </article>

      <article class="flex min-h-[25rem] flex-col border border-slate-200 bg-white px-4 py-3">
        <a href={productLinks.energyStorage} class="group flex h-full flex-col" aria-label={t.products.items[1].name}>
          <figure class="mb-8 flex h-52 items-center justify-center overflow-hidden p-3">
            <img
              src={productImages.energyStorage}
              alt={t.products.items[1].imageAlt}
              class="h-full w-full object-contain transition-transform group-hover:scale-105"
              loading="lazy"
            />
          </figure>
          <div class="px-2 text-center">
            <h3 class="mb-5 text-xl font-semibold leading-snug text-slate-900">{t.products.items[1].name}</h3>
            <p class="text-base leading-relaxed text-slate-900">{t.products.items[1].desc}</p>
          </div>
        </a>
      </article>

      <article class="flex min-h-[25rem] flex-col border border-slate-200 bg-white px-4 py-3">
        <a href={productLinks.batterySwap} class="group flex h-full flex-col" aria-label={t.products.items[2].name}>
          <figure class="mb-8 flex h-52 items-center justify-center overflow-hidden p-3">
            <img
              src={productImages.batterySwap}
              alt={t.products.items[2].imageAlt}
              class="h-full w-full object-contain transition-transform group-hover:scale-105"
              loading="lazy"
            />
          </figure>
          <div class="px-2 text-center">
            <h3 class="mb-5 text-xl font-semibold leading-snug text-slate-900">{t.products.items[2].name}</h3>
            <p class="text-base leading-relaxed text-slate-900">{t.products.items[2].desc}</p>
          </div>
        </a>
      </article>
    </div>
  </section>

  <section id="downloads" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <h2 class="text-2xl font-bold tracking-tight text-[#101b70] sm:text-3xl">{t.downloads.title}</h2>
    </div>

    <div class="grid gap-3 p-5">
      <a
        href="#"
        class="flex flex-col justify-between gap-2 border border-slate-200 bg-white p-4 transition-colors hover:border-brand-red md:flex-row"
      >
        <strong class="text-slate-900">{t.downloads.item1}</strong>
        <span class="text-sm text-slate-500">{t.downloads.meta1}</span>
      </a>
      <a
        href="#"
        class="flex flex-col justify-between gap-2 border border-slate-200 bg-white p-4 transition-colors hover:border-brand-red md:flex-row"
      >
        <strong class="text-slate-900">{t.downloads.item2}</strong>
        <span class="text-sm text-slate-500">{t.downloads.meta2}</span>
      </a>
      <a
        href="#"
        class="flex flex-col justify-between gap-2 border border-slate-200 bg-white p-4 transition-colors hover:border-brand-red md:flex-row"
      >
        <strong class="text-slate-900">{t.downloads.item3}</strong>
        <span class="text-sm text-slate-500">{t.downloads.meta3}</span>
      </a>
    </div>
  </section>

  <section id="contact" class="scroll-mt-24 pt-8">
    <div class="mb-4">
      <h2 class="text-2xl font-bold tracking-tight text-[#101b70] sm:text-3xl">
        {t.contact.tag}
      </h2>
    </div>

    <div class="grid gap-6 rounded-lg bg-white p-5 lg:grid-cols-2">
      <p class="mb-4 text-base font-semibold uppercase tracking-[0.16em] text-slate-700">
        {t.contact.titleLine1}<br />{t.contact.titleLine2}
      </p>
      <div class="space-y-2 text-slate-700">
        <p><strong>{t.contact.salesLabel}</strong>+86 0513-88888888</p>
        <p><strong>{t.contact.supportLabel}</strong>+86 0513-88888999</p>
        <p><strong>{t.contact.emailLabel}</strong>contact@linked-power.com</p>
        <p><strong>{t.contact.addressLabel}</strong>{t.contact.addressValue}</p>
        <div class="pt-2">
          <button
            type="button"
            data-open-consult-form
            class="inline-flex items-center justify-center bg-brand-red px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-brand-red-dark"
          >
            {t.about.ctaConsult}
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="scroll-mt-24 pt-8 text-center text-sm text-slate-500">
    <p>{t.footer.copyright}</p>
  </section>
</main>

<div id="consultModal" class="fixed inset-0 z-[100] hidden bg-black/45 p-4">
  <div class="mx-auto mt-10 w-full max-w-xl border border-slate-200 bg-white p-5 shadow-xl">
    <div class="mb-4 flex items-start justify-between gap-4">
      <h3 class="text-lg font-semibold text-slate-900">{t.contact.formTitle}</h3>
      <button
        type="button"
        data-close-consult-form
        class="inline-flex rounded border border-slate-300 px-2 py-1 text-xs font-semibold text-slate-700 transition-colors hover:border-brand-red hover:text-brand-red"
      >
        ×
      </button>
    </div>

    <form
      id="contactForm"
      class="space-y-3"
      data-locale={locale}
      data-msg-submitting={formMessages.submitting}
      data-msg-success={formMessages.success}
      data-msg-error={formMessages.error}
    >
      <label class="block text-sm text-slate-700" for="contactName">{t.contact.formNameLabel}</label>
      <input
        id="contactName"
        name="name"
        required
        class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-brand-red"
        type="text"
      />

      <label class="block text-sm text-slate-700" for="contactPhone">{t.contact.formPhoneLabel}</label>
      <input
        id="contactPhone"
        name="phone"
        required
        class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-brand-red"
        type="tel"
      />

      <label class="block text-sm text-slate-700" for="contactCompany">{t.contact.formCompanyLabel}</label>
      <input
        id="contactCompany"
        name="company"
        class="w-full border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-brand-red"
        type="text"
      />

      <label class="block text-sm text-slate-700" for="contactMessage">{t.contact.formMessageLabel}</label>
      <textarea
        id="contactMessage"
        name="message"
        required
        rows="4"
        class="w-full resize-y border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-brand-red"
      ></textarea>

      <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />

      <div class="flex items-center gap-3">
        <button
          id="contactSubmit"
          type="submit"
          class="inline-flex items-center justify-center bg-brand-red px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-red-dark disabled:opacity-70"
        >
          {t.contact.formSubmit}
        </button>
        <button
          type="button"
          data-close-consult-form
          class="inline-flex items-center justify-center border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-400"
        >
          {t.contact.formCancel}
        </button>
      </div>

      <p id="contactStatus" class="min-h-5 text-sm text-slate-600"></p>
    </form>
  </div>
</div>

<script>
  const modal = document.getElementById('consultModal');
  const form = document.getElementById('contactForm');
  const status = document.getElementById('contactStatus');
  const submit = document.getElementById('contactSubmit');

  function openModal() {
    if (!modal) {
      return;
    }
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
    const nameInput = document.getElementById('contactName');
    if (nameInput instanceof HTMLInputElement) {
      nameInput.focus();
    }
  }

  function closeModal() {
    if (!modal) {
      return;
    }
    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  document.querySelectorAll('[data-open-consult-form]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      openModal();
    });
  });

  document.querySelectorAll('[data-close-consult-form]').forEach((trigger) => {
    trigger.addEventListener('click', closeModal);
  });

  if (modal) {
    modal.addEventListener('click', (event) => {
      if (event.target === modal) {
        closeModal();
      }
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeModal();
    }
  });

  if (form instanceof HTMLFormElement && status && submit instanceof HTMLButtonElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const locale = form.dataset.locale || 'zh';
      const submittingText = form.dataset.msgSubmitting || 'Submitting...';
      const successText = form.dataset.msgSuccess || 'Success';
      const errorText = form.dataset.msgError || 'Error';

      const formData = new FormData(form);
      const payload = {
        locale,
        name: String(formData.get('name') || '').trim(),
        phone: String(formData.get('phone') || '').trim(),
        company: String(formData.get('company') || '').trim(),
        message: String(formData.get('message') || '').trim(),
        website: String(formData.get('website') || '').trim(),
      };

      submit.disabled = true;
      status.textContent = submittingText;
      status.className = 'min-h-5 text-sm text-slate-500';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) {
          throw new Error('request_failed');
        }

        form.reset();
        status.textContent = successText;
        status.className = 'min-h-5 text-sm text-green-700';
        closeModal();
      } catch {
        status.textContent = errorText;
        status.className = 'min-h-5 text-sm text-red-600';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
