---
import { homeContent, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = homeContent[locale];
const basePath = locale === 'en' ? '/en' : '';
const navItems = [
  { label: t.nav.home, href: `${basePath}/` },
  { label: t.nav.products, href: `${basePath}/#products` },
  { label: t.nav.downloads, href: `${basePath}/#downloads` },
  { label: t.nav.contact, href: `${basePath}/#contact` },
];
const switchHref = locale === 'en' ? '/' : '/en/';
const switchLabel = locale === 'en' ? '中文' : 'EN';
const switchAria = locale === 'en' ? 'Switch to Chinese' : 'Switch to English';
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-lg">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-4">
    <a href={`${basePath}/`} aria-label="Linked Power">
      <img
        src="/logo.png"
        alt="Linked Power"
        class="h-9 w-auto max-w-40 object-contain"
      />
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="主导航">
      {navItems.map((item) => (
        <a class="text-sm font-medium tracking-[0.04em] text-slate-600 transition-colors hover:text-brand-red" href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a
        href={switchHref}
        class="inline-flex rounded-full border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 transition-colors hover:border-brand-red hover:text-brand-red"
        aria-label={switchAria}
      >
        {switchLabel}
      </a>
      <button
        type="button"
        data-open-consult-form
        class="rounded-full bg-brand-red px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-red-dark"
      >
        {t.nav.cta}
      </button>
    </div>

    <button
      id="menuToggle"
      class="inline-flex flex-col gap-1 rounded-lg border border-slate-300 p-2 text-slate-700 lg:hidden"
      aria-label="切换菜单"
      aria-expanded="false"
      aria-controls="mobileMenu"
      type="button"
    >
      <span class="block h-0.5 w-5 bg-current"></span>
      <span class="block h-0.5 w-5 bg-current"></span>
      <span class="block h-0.5 w-5 bg-current"></span>
    </button>
  </div>

  <div id="mobileMenu" class="hidden border-t border-slate-200 bg-white" aria-label="移动端菜单">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-5 py-3">
      {navItems.map((item) => (
        <a class="rounded-md px-2 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-brand-red" href={item.href}>
          {item.label}
        </a>
      ))}
      <div class="mt-2 flex items-center gap-2">
        <a
          href={switchHref}
          class="inline-flex rounded-full border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 transition-colors hover:border-brand-red hover:text-brand-red"
          aria-label={switchAria}
        >
          {switchLabel}
        </a>
        <button
          type="button"
          data-open-consult-form
          class="inline-flex w-fit rounded-full bg-brand-red px-4 py-2 text-sm font-semibold text-white"
        >
          {t.nav.cta}
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      const expanded = !isHidden;
      toggle.setAttribute('aria-expanded', String(expanded));
    });
  }
</script>
